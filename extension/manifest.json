{
  "manifest_version": 3,
  "name": "Open Email Harvester",
  "short_name": "OEH",
  "version": "1.0.0",
  "description": "Privacy-first, local-only contact extractor for any website. Emails (obfuscation-aware), phones, social links. Connect any AI via MCP/OpenAPI.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": { "default_popup": "popup.html", "default_title": "Open Email Harvester", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": { "scan-page": { "suggested_key": { "default": "Alt+Shift+E" }, "description": "Scan current page" } },
  "browser_specific_settings": { "gecko": { "id": "open-email-harvester@users.noreply.github.com", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } } }
}
